<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Kvevri Gold</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert" style="text-align:center;margin-top:20vh">Nothing here. <a href="">Back to the game</a></p>
        </LayoutView>
    </NotFound>
</Router>
