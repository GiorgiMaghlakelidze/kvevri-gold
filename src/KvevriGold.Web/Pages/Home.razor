@page "/"
@implements IDisposable
@inject DemoSession Session
@inject NavigationManager Nav

<PageTitle>Kvevri Gold · playable demo</PageTitle>
<SymbolDefs />

<main class="game @(_fsActive ? "fs-mode" : "")">
    <header class="top">
        <div class="brand">
            <h1>Kvevri Gold</h1>
            <p class="tag">5x3 · 243 ways · cascades · free spins up to x10</p>
        </div>
        <div class="demo-badge" title="This is a portfolio demo. Balance is play money.">DEMO · play money, no real money</div>
    </header>

    <section class="fs-bar" aria-live="polite">
        @if (_fsActive)
        {
            <div class="fs-count">FREE SPINS <strong>@_fsPlayed / @_fsTotal</strong></div>
            <div class="meter" aria-label="@($"Progressive multiplier x{_meter}")">
                @for (int i = 1; i <= MaxMultiplier; i++)
                {
                    <span class="pip @(i <= _meter ? "on" : "") @(i == _meter ? "cur" : "")">@($"x{i}")</span>
                }
            </div>
        }
        else
        {
            <div class="fs-hint"><span class="hint-sym"><SlotSymbol Code="S" /></span> 3+ Rtveli scatters = free spins, multiplier up to x10</div>
        }
    </section>

    <section class="reels-wrap">
        <div class="reels" role="grid" aria-label="Reels">
            @for (int reel = 0; reel < Reels; reel++)
            {
                int r = reel;
                <div class="reel @(_spinning[r] ? "spinning" : "")">
                    @for (int row = 0; row < Rows; row++)
                    {
                        int w = row;
                        <div class="cell @CellClass(r, w)" @key="CellKey(r, w)">
                            <SlotSymbol Code="@_board[r][w]" />
                        </div>
                    }
                </div>
            }
        </div>
        @if (_banner is not null)
        {
            <div class="banner @_bannerClass" @onclick="RequestSkip">@((MarkupString)_banner)</div>
        }
    </section>

    <section class="message" aria-live="polite">
        @if (_winLines.Count > 0)
        {
            @foreach (var line in _winLines)
            {
                <div class="win-line">@line</div>
            }
        }
        else
        {
            <div class="win-line muted">@_message</div>
        }
    </section>

    <section class="controls">
        <div class="readout">
            <span class="label">Balance <em>(demo)</em></span>
            <span class="value">@Money(_displayBalance)</span>
        </div>
        <div class="readout bet">
            <span class="label">Bet</span>
            <div class="bet-row">
                <button class="round-btn" @onclick="() => StepBet(-1)" disabled="@(!CanChangeSettings || _betIndex == 0)" aria-label="Lower bet">−</button>
                <span class="value">@Money(Session.InFreeSpins ? Session.Context.RoundBet : Session.Bet)</span>
                <button class="round-btn" @onclick="() => StepBet(1)" disabled="@(!CanChangeSettings || _betIndex == DemoSession.BetSteps.Count - 1)" aria-label="Raise bet">+</button>
            </div>
        </div>
        <div class="readout">
            <span class="label">Win</span>
            <span class="value win @(_spinWin > 0 ? "pos" : "")">@Money(_spinWin)</span>
        </div>

        <button class="spin @(_busy ? "busy" : "")" @onclick="OnSpin" disabled="@(!_busy && !Session.CanAfford)" aria-label="@SpinLabel">
            <span>@SpinLabel</span>
        </button>

        <div class="toggles">
            <label class="switch">
                <input type="checkbox" @bind="_turbo" />
                <span>Turbo</span>
            </label>
            <div class="seg" role="group" aria-label="RTP variant">
                @foreach (var v in Variants)
                {
                    string id = v;
                    <button class="@(Session.Variant == id ? "on" : "")" disabled="@(!CanChangeSettings)" @onclick="() => SetVariant(id)">RTP @id%</button>
                }
            </div>
        </div>
    </section>

    @if (!Session.CanAfford && !_busy)
    {
        <div class="refill">
            Out of demo credits. <button class="link-btn" @onclick="Refill">Refill play money</button>
        </div>
    }

    <section class="panels">
        <div class="panel stats">
            <h2>Session stats</h2>
            <dl>
                <dt>Paid spins</dt><dd>@_stats.PaidSpins.ToString("N0")</dd>
                <dt>Free spins</dt><dd>@_stats.FreeSpins.ToString("N0")</dd>
                <dt>Total bet</dt><dd>@Money(_stats.TotalBet)</dd>
                <dt>Total won</dt><dd>@Money(_stats.TotalWon)</dd>
                <dt>Session RTP</dt><dd>@(_stats.Rtp is double rtp ? rtp.ToString("P2") : "—")</dd>
                <dt>Biggest round</dt><dd>@Money(_stats.BiggestWin)</dd>
            </dl>
            <p class="note">Short sessions swing a lot. Variant @Session.Variant targets @(Session.Game.Definition.Variant.TargetRtp.ToString("P0")) RTP in the long run (measured @(Session.Variant == "94" ? "93.97%" : "96.04%") over 100M simulated rounds).</p>
            <button class="link-btn" @onclick="ResetStats" disabled="@_busy">Reset stats</button>
        </div>

        <details class="panel rules">
            <summary>Paytable &amp; rules</summary>
            <table class="paytable">
                <thead><tr><th>Symbol</th><th>3</th><th>4</th><th>5</th></tr></thead>
                <tbody>
                    @foreach (var (sym, pays) in Session.Config.Paytable)
                    {
                        <tr>
                            <td class="pt-sym"><span class="mini"><SlotSymbol Code="@sym" /></span>@SymbolInfo.Name(sym)</td>
                            @foreach (var p in pays)
                            {
                                <td>@((p / (decimal)CoinsPerBet).ToString("0.00"))x</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <ul>
                <li>Pays per way, left to right from reel 1 on adjacent reels, as a multiple of the total bet.</li>
                <li><strong>Golden Fleece</strong> wild lands on reels 2–5 and substitutes for every symbol except the scatter.</li>
                <li><strong>Cascades:</strong> winning symbols are removed, the rest fall, new ones drop in, and it repeats until there is no win.</li>
                <li><strong>Rtveli</strong> scatter pays anywhere: 3 = 2x, 4 = 10x, 5+ = 50x. 3 / 4 / 5+ award 8 / 12 / 15 free spins (retrigger 5 / 8 / 10).</li>
                <li>In free spins every winning cascade raises the multiplier by 1, up to x10, and it never resets during the feature.</li>
                <li>Max win 5,000x bet per round.</li>
            </ul>
        </details>
    </section>

    <footer class="foot">
        <p>Original portfolio project by Giorgi Maghlakelidze. The C# / .NET 8 engine from this repository runs in your browser through WebAssembly, with an OS-grade random number generator. Not a gambling product, no real money.</p>
        @if (Session.Seed is ulong seedUsed)
        {
            <p>Seeded replay mode: seed @seedUsed (deterministic xoshiro256** stream, same as the simulator). Remove <code>?seed=</code> for normal play.</p>
        }
        <p><a href="https://github.com/GiorgiMaghlakelidze/kvevri-gold" target="_blank" rel="noopener">Source code on GitHub</a> · Space or Enter spins when the button is focused · click Spin during a spin to skip</p>
    </footer>
</main>

@code {
    private const int Reels = 5, Rows = 3, CoinsPerBet = 20;
    private static readonly IReadOnlyList<string> Variants = KvevriGold.Engine.Game.GameFactory.Variants;
    private int MaxMultiplier => Session.Config.FreeSpins.MultiplierMax;

    private string[][] _board = InitialArt();
    private readonly bool[] _spinning = new bool[Reels];
    private readonly HashSet<(int, int)> _highlight = new();
    private readonly HashSet<(int, int)> _popping = new();
    private readonly int[,] _dropGen = new int[Reels, Rows];
    private readonly HashSet<(int, int)> _dropping = new();
    private bool _dim;

    private bool _busy, _turbo, _skip, _disposed;
    private CancellationTokenSource _skipCts = new();
    private decimal _displayBalance, _spinWin;
    private string _message = "Pick a bet and press Spin. Good luck!";
    private readonly List<string> _winLines = new();
    private string? _banner;
    private string _bannerClass = "";

    private bool _fsActive;
    private int _fsPlayed, _fsTotal, _meter = 1;

    private int _betIndex;
    private SessionStats _stats;
    private bool CanChangeSettings => !_busy && !Session.InFreeSpins;
    private string SpinLabel => _busy ? "Skip" : Session.InFreeSpins ? "Free spin" : "Spin";

    protected override void OnInitialized()
    {
        // ?seed=N replays a reproducible RNG stream (handy for demos: ?seed=1155 opens with free spins at bet 1.00, RTP 96%).
        var query = new Uri(Nav.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in query)
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "seed" && ulong.TryParse(kv[1], out ulong seed) && Session.TryUseSeed(seed))
                _message = $"Seeded replay mode (seed {seed}). Press Spin.";
        }
        _displayBalance = Session.Balance;
        _stats = Session.Snapshot();
        _betIndex = IndexOfBet(Session.Bet);
        if (Session.InFreeSpins) SyncFreeSpinsBar(Session.Context.FreeSpinsPlayed, Session.Context.FreeSpinsAwardedTotal, Session.Context.Multiplier);
    }

    private static string[][] InitialArt() => new[]
    {
        new[] { "GR", "TA", "A" }, new[] { "KV", "W", "K" }, new[] { "S", "KN", "Q" }, new[] { "CH", "W", "J" }, new[] { "TA", "KV", "T" },
    };

    private static int IndexOfBet(decimal bet)
    {
        for (int i = 0; i < DemoSession.BetSteps.Count; i++) if (DemoSession.BetSteps[i] == bet) return i;
        return 0;
    }

    private static string Money(decimal v) => v.ToString("#,##0.00");

    private string CellKey(int reel, int row) => $"{reel}:{row}:{_dropGen[reel, row]}";

    private string CellClass(int reel, int row)
    {
        var p = (reel, row);
        if (_popping.Contains(p)) return "pop";
        if (_highlight.Contains(p)) return "hit";
        string cls = _dropping.Contains(p) ? "drop" : "";
        return _dim ? cls + " dim" : cls;
    }

    private void StepBet(int delta)
    {
        int next = Math.Clamp(_betIndex + delta, 0, DemoSession.BetSteps.Count - 1);
        _betIndex = next;
        Session.SetBet(DemoSession.BetSteps[next]);
    }

    private void SetVariant(string id) => Session.SetVariant(id);

    private void Refill()
    {
        Session.RefillBalance();
        _displayBalance = Session.Balance;
        _message = "Play money refilled.";
    }

    private void ResetStats()
    {
        Session.ResetStats();
        _stats = Session.Snapshot();
    }

    private int T(int ms) => _turbo ? ms / 4 : ms;

    private async Task Pause(int ms)
    {
        if (_skip || ms <= 0 || _disposed) return;
        try { await Task.Delay(ms, _skipCts.Token); }
        catch (OperationCanceledException) { }
    }

    private void RequestSkip()
    {
        if (!_busy) return;
        _skip = true;
        _skipCts.Cancel();
    }

    private async Task OnSpin()
    {
        if (_busy) { RequestSkip(); return; }
        if (!Session.CanAfford) return;
        _busy = true;
        try
        {
            await PlaySpin();
            // Free spins play out automatically, one after another.
            while (Session.InFreeSpins && !_disposed)
            {
                await Pause(T(700));
                await PlaySpin();
            }
        }
        finally
        {
            _busy = false;
            _skip = false;
            StateHasChanged();
        }
    }

    private async Task PlaySpin()
    {
        _skip = false;
        _skipCts.Dispose();
        _skipCts = new CancellationTokenSource();

        SpinResult r = Session.Spin();
        decimal unit = r.Bet / CoinsPerBet;
        bool free = r.Mode == KvevriGold.Engine.Model.GameMode.FreeSpins;

        ClearMarks();
        _banner = null;
        _winLines.Clear();
        _displayBalance -= r.Stake;
        if (!free) _spinWin = 0;
        _message = free ? $"Free spin {r.FreeSpinsPlayed}" : "Spinning…";
        if (free) SyncFreeSpinsBar(r.FreeSpinsPlayed, r.FreeSpinsPlayed + r.FreeSpinsRemaining - r.FreeSpinsAwarded, _meter);

        // 1. Reels spin, then stop left to right on the initial board.
        for (int i = 0; i < Reels; i++) _spinning[i] = true;
        StateHasChanged();
        await Pause(T(420));
        string[][] start = r.InitialBoard!;
        for (int reel = 0; reel < Reels; reel++)
        {
            _spinning[reel] = false;
            _board[reel] = start[reel];
            for (int row = 0; row < Rows; row++) MarkDrop(reel, row);
            StateHasChanged();
            await Pause(T(120));
        }
        _dropping.Clear();
        await Pause(T(200));

        // 2. Cascades, one step at a time.
        for (int s = 0; s < r.Cascades.Count; s++)
        {
            CascadeStepDto step = r.Cascades[s];
            _board = step.Board!;
            _highlight.Clear();
            foreach (var win in step.Wins)
                foreach (var pos in win.Positions) _highlight.Add((pos[0], pos[1]));
            _dim = true;
            _spinWin += step.WinCoins * unit;
            _winLines.Clear();
            foreach (var win in step.Wins.OrderByDescending(w => w.WinCoins).Take(3))
                _winLines.Add(DescribeWin(win, step.Multiplier, unit));
            if (step.Wins.Count > 3) _winLines.Add($"+{step.Wins.Count - 3} more");
            if (r.Cascades.Count > 1) _winLines.Insert(0, $"Cascade {s + 1} of {r.Cascades.Count}" + (step.Multiplier > 1 ? $" · x{step.Multiplier}" : ""));
            if (free) _meter = step.Multiplier;
            StateHasChanged();
            await Pause(T(950));

            // Winning symbols burst, the rest fall and new symbols drop in.
            foreach (var p in _highlight) _popping.Add(p);
            _highlight.Clear();
            StateHasChanged();
            await Pause(T(260));

            string[][] next = s + 1 < r.Cascades.Count ? r.Cascades[s + 1].Board! : r.FinalBoard!;
            for (int reel = 0; reel < Reels; reel++)
            {
                int lowest = -1;
                for (int row = 0; row < Rows; row++) if (_popping.Contains((reel, row))) lowest = row;
                for (int row = 0; row <= lowest; row++) MarkDrop(reel, row);
            }
            _popping.Clear();
            _dim = false;
            _board = next;
            if (free) _meter = Math.Min(step.Multiplier + 1, MaxMultiplier);
            StateHasChanged();
            await Pause(T(330));
            _dropping.Clear();
        }
        if (free) _meter = r.Multiplier;

        // 3. Scatters and free spins.
        if (r.Scatters >= 3)
        {
            string[][] fin = r.FinalBoard!;
            for (int reel = 0; reel < Reels; reel++)
                for (int row = 0; row < Rows; row++)
                    if (fin[reel][row] == "S") _highlight.Add((reel, row));
            _dim = true;
            _spinWin += r.ScatterWinCoins * unit;
            _winLines.Clear();
            _winLines.Add($"{r.Scatters} Rtveli scatters pay {Money(r.ScatterWinCoins * unit)}");
            if (r.FreeSpinsAwarded > 0)
            {
                bool retrigger = free;
                _banner = retrigger ? $"<b>+{r.FreeSpinsAwarded}</b> free spins!" : $"<small>RTVELI</small><b>{r.FreeSpinsAwarded} FREE SPINS</b><small>multiplier grows with every winning cascade</small>";
                _bannerClass = "fs";
                SyncFreeSpinsBar(r.FreeSpinsPlayed, r.FreeSpinsPlayed + r.FreeSpinsRemaining, free ? _meter : 1);
            }
            StateHasChanged();
            await Pause(T(1600));
            _banner = null;
            ClearMarks();
        }

        // 4. Settle: the engine's figures are authoritative (they include the max-win cap).
        _displayBalance = Session.Balance;
        _stats = Session.Snapshot();
        _spinWin = free ? r.RoundWin : r.Win;

        if (r.MaxWinReached)
        {
            _banner = $"<small>MAX WIN</small><b>{Money(r.RoundWin)}</b><small>5,000x bet reached</small>";
            _bannerClass = "big";
            StateHasChanged();
            await Pause(T(2400));
            _banner = null;
        }
        else if (free && r.RoundComplete)
        {
            _banner = $"<small>FREE SPINS TOTAL</small><b>{Money(r.RoundWin)}</b><small>{r.FreeSpinsPlayed} spins · top multiplier x{r.Multiplier}</small>";
            _bannerClass = "big";
            StateHasChanged();
            await Pause(T(2600));
            _banner = null;
        }
        else if (!free && r.RoundComplete && r.Win >= r.Bet * 10)
        {
            _banner = $"<small>BIG WIN</small><b>{Money(r.Win)}</b><small>{(r.Win / r.Bet):0.#}x bet</small>";
            _bannerClass = "big";
            StateHasChanged();
            await Pause(T(1800));
            _banner = null;
        }

        if (r.RoundComplete) _fsActive = false;
        if (_winLines.Count == 0)
            _message = r.Win > 0 ? $"Win {Money(r.Win)}" : free ? "No win this free spin" : "No win. Spin again!";
        StateHasChanged();
    }

    private void SyncFreeSpinsBar(int played, int total, int meter)
    {
        _fsActive = true;
        _fsPlayed = played;
        _fsTotal = Math.Max(total, played);
        _meter = Math.Max(1, meter);
    }

    private string DescribeWin(WayWinDto win, int multiplier, decimal unit)
    {
        string mult = multiplier > 1 ? $" × x{multiplier}" : "";
        string ways = win.Ways == 1 ? "1 way" : $"{win.Ways} ways";
        return $"{SymbolInfo.Name(win.Symbol)} ×{win.Length} · {ways}{mult} = {Money(win.WinCoins * unit)}";
    }

    private void MarkDrop(int reel, int row)
    {
        _dropGen[reel, row]++;
        _dropping.Add((reel, row));
    }

    private void ClearMarks()
    {
        _highlight.Clear();
        _popping.Clear();
        _dropping.Clear();
        _dim = false;
    }

    public void Dispose()
    {
        _disposed = true;
        _skipCts.Cancel();
        _skipCts.Dispose();
    }
}
